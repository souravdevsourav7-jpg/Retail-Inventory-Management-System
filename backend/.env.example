# Aiven / MySQL connection
DB_HOST=your-aiven-host
DB_PORT=your-aiven-port
DB_USER=your-database-user
DB_PASSWORD=replace-with-your-database-password
DB_NAME=defaultdb
DB_CA_CERT="-----BEGIN CERTIFICATE-----\nPASTE_YOUR_CA_CERTIFICATE_HERE\n-----END CERTIFICATE-----"

# Generate a long random secret. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Gmail App Password for email OTP registration
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=replace-with-your-gmail-app-password
